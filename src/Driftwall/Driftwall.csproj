<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Driftwall</AssemblyName>
    <RootNamespace>Driftwall</RootNamespace>
    <!-- Version-info block Windows shows in Properties > Details, Task Manager and security prompts.
         Driftwall is a Project Max application; the publisher is the project, the product is the app. -->
    <Product>Driftwall</Product>
    <Company>Project Max</Company>
    <AssemblyTitle>Driftwall</AssemblyTitle>
    <Description>Desktop wallpaper switcher for Windows: photos from the web and your own folders, on a schedule, on every monitor.</Description>
    <Copyright>Copyright © 2026 Project Max</Copyright>
    <PackageProjectUrl>https://projectmax.app/driftwall</PackageProjectUrl>
    <RepositoryUrl>https://github.com/projectmax-org/driftwall</RepositoryUrl>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Runtime/perf tuning: keep idle footprint small. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>


  <!-- The WindowsDesktop SDK's implicit usings omit these two; the codebase assumes both. -->
  <!-- The self-test harness drives the internal COM interop directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SelfTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <!-- Assets are build inputs, not loose runtime files: app.ico is embedded as a Win32 resource by
       ApplicationIcon (and read back from there for the tray icon, which is what keeps single-file
       publishing to one executable), and logo-512.png is embedded as a WPF resource for the title
       bar. Both come from tools/IconGen, so every icon the user sees is the same drawing. -->
  <ItemGroup>
    <None Update="Assets\**" CopyToOutputDirectory="Never" />
    <None Remove="Assets\logo-512.png" />
    <Resource Include="Assets\logo-512.png" />
  </ItemGroup>

</Project>
