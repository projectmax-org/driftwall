<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Light palette. Keys mirror Palette.Dark.xaml exactly. -->

    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>

    <Color x:Key="Color.Base">#FFF4F4F8</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFFAFAFD</Color>
    <Color x:Key="Color.Elevated">#FFFFFFFF</Color>
    <Color x:Key="Color.Hover">#FFEDEDF4</Color>
    <Color x:Key="Color.Pressed">#FFE2E2EC</Color>
    <Color x:Key="Color.Border">#FFE3E3EC</Color>
    <Color x:Key="Color.BorderStrong">#FFCFCFDC</Color>

    <Color x:Key="Color.TextPrimary">#FF15151C</Color>
    <Color x:Key="Color.TextSecondary">#FF5B5B6E</Color>
    <Color x:Key="Color.TextMuted">#FF8C8C9E</Color>
    <Color x:Key="Color.TextOnAccent">#FFFFFFFF</Color>

    <Color x:Key="Color.Accent">#FF6A59E8</Color>
    <Color x:Key="Color.AccentHover">#FF7A6AF2</Color>
    <Color x:Key="Color.AccentPressed">#FF5A49D4</Color>
    <Color x:Key="Color.AccentSoft">#1F6A59E8</Color>

    <Color x:Key="Color.Danger">#FFD93A52</Color>
    <Color x:Key="Color.Success">#FF17A673</Color>
    <Color x:Key="Color.Warning">#FFC98207</Color>

    <Color x:Key="Color.Scrim">#66000000</Color>
    <Color x:Key="Color.Shadow">#22000000</Color>

    <SolidColorBrush x:Key="Brush.Base" Color="{DynamicResource Color.Base}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="{DynamicResource Color.Elevated}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{DynamicResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{DynamicResource Color.Pressed}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource Color.BorderStrong}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{DynamicResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{DynamicResource Color.TextOnAccent}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{DynamicResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{DynamicResource Color.AccentSoft}" />

    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="{DynamicResource Color.Scrim}" />

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6D5EF6" Offset="0" />
        <GradientStop Color="#FFB84BF0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.PhotoScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#66000000" Offset="0.55" />
        <GradientStop Color="#D8000000" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
