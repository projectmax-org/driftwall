<UserControl x:Class="Driftwall.UI.Views.DisplaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Driftwall.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DisplaysViewModel}"
             Background="{DynamicResource Brush.Base}">

    <UserControl.Resources>

        <!-- A settings row: the chrome of ListItem.Row without the selection behaviour of a list. -->
        <Style x:Key="DisplayRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Medium}" />
            <Setter Property="Padding" Value="11,10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One display in the layout map, drawn at its own aspect ratio so the map reads like the desk. -->
        <DataTemplate x:Key="MonitorTileTemplate" DataType="{x:Type vm:MonitorViewModel}">
            <Border Width="{Binding AspectRatio, Converter={StaticResource Multiply}, ConverterParameter=150}"
                    Height="150" MinWidth="128"
                    Margin="0,0,14,14"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Large}"
                    ClipToBounds="True">
                <Border.ToolTip>
                    <StackPanel MaxWidth="300">
                        <TextBlock Text="{Binding PhotoTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PhotoCredit}"
                                   Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding PhotoCredit, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Border.ToolTip>

                <Grid>
                    <!-- What is on this display right now -->
                    <Image Source="{Binding Preview}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Nothing rendered for it yet -->
                    <Border Background="{DynamicResource Brush.SurfaceAlt}"
                            Visibility="{Binding Preview, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                        <Path Style="{StaticResource Icon.Large}" Data="{DynamicResource Icon.Monitor}"
                              Stroke="{DynamicResource Brush.TextMuted}" Opacity="0.35"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Border Background="{DynamicResource Brush.PhotoScrim}" />

                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9"
                            Background="{DynamicResource Brush.Accent}"
                            CornerRadius="{StaticResource CornerRadius.Pill}"
                            Padding="8,2"
                            Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Primary" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextOnAccent}" />
                    </Border>

                    <StackPanel x:Name="Caption" VerticalAlignment="Bottom" Margin="11,0,11,9">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="White" FontWeight="SemiBold" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Resolution}"
                                   Foreground="#CCFFFFFF" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>

                    <!-- Hover actions for this one display -->
                    <Grid x:Name="Overlay" Opacity="0">
                        <Border Background="#8C000000" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Accent}"
                                    Content="New photo"
                                    FontSize="11.5" Height="28" MinHeight="28" Padding="10,0"
                                    Command="{Binding DataContext.NextForMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Put a different photo on this display" />
                            <Button Style="{StaticResource Button.Base}"
                                    Width="28" Height="28" MinHeight="0" Padding="0" Margin="6,0,0,0"
                                    Background="#59000000" BorderBrush="#40FFFFFF"
                                    Command="{Binding DataContext.OpenRenderedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Show the rendered file on disk">
                                <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Folder}"
                                      Stroke="White" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.14" />
                                <DoubleAnimation Storyboard.TargetName="Caption" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.14" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Border.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.14" />
                                <DoubleAnimation Storyboard.TargetName="Caption" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.14" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </DataTemplate>

        <!-- One row of per-display overrides -->
        <DataTemplate x:Key="MonitorRowTemplate" DataType="{x:Type vm:MonitorViewModel}">
            <Border Style="{StaticResource DisplayRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="168" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Subheading}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Margin="8,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.AccentSoft}"
                                    CornerRadius="{StaticResource CornerRadius.Pill}"
                                    Padding="7,1"
                                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Primary" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding Resolution}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="&#183;" Style="{StaticResource Text.Caption}" Margin="6,0" />
                            <TextBlock Text="{Binding OrientationLabel}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>

                        <TextBlock Text="Left alone when the wallpaper rotates."
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    </StackPanel>

                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  IsChecked="{Binding Enabled}"
                                  ToolTip="Include this display when the wallpaper rotates" />

                    <ComboBox Grid.Column="2" Width="156"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              ItemsSource="{Binding DataContext.ScalingModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding ScalingOverride}"
                              ToolTip="Scaling for this display only. Blank follows the setting above." />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Header ====================
             Fixed strip on Brush.Surface with a hairline underneath, the same header shape
             Browse and Settings use, so the title does not scroll away with the cards. -->
        <Border Grid.Row="0" Padding="20,16,20,14"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel MaxWidth="900">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Displays" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="{Binding LayoutSummary}" Style="{StaticResource Text.Body}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Secondary first, primary rightmost. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Button Style="{StaticResource Button.Base}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Scan again after plugging in or unplugging a monitor">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Refresh}" />
                                <TextBlock Text="Detect displays" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Accent}" Margin="8,0,0,0"
                                Content="Re-apply now"
                                Command="{Binding ApplyNowCommand}"
                                ToolTip="Render the current photos again for this exact layout" />
                    </StackPanel>
                </Grid>

                <!-- ==================== Status ==================== -->
                <Border Background="{DynamicResource Brush.AccentSoft}"
                        CornerRadius="{StaticResource CornerRadius.Small}"
                        Padding="10,6" Margin="0,11,0,0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Info}"
                              Stroke="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" MaxWidth="720"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ==================== Everything else scrolls ==================== -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20">
            <StackPanel MaxWidth="900">

            <!-- ==================== Layout map ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="YOUR LAYOUT" Style="{StaticResource Text.SectionLabel}" />

                    <Grid>
                        <ItemsControl ItemsSource="{Binding Monitors}"
                                      ItemTemplate="{StaticResource MonitorTileTemplate}"
                                      Margin="0,0,0,-14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Empty state: enumeration failed, or every display was disconnected -->
                        <StackPanel HorizontalAlignment="Center" MaxWidth="360" Margin="0,26,0,30"
                                    Visibility="{Binding Monitors.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <Path Style="{StaticResource Icon.Large}" Data="{DynamicResource Icon.Monitor}"
                                  Width="44" Height="44" Opacity="0.28"
                                  Stroke="{DynamicResource Brush.TextMuted}"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="No displays detected"
                                       Style="{StaticResource Text.Body}"
                                       TextAlignment="Center" Margin="0,16,0,0" />
                            <TextBlock Text="Reconnect a monitor, then press Detect displays."
                                       Style="{StaticResource Text.Caption}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Each display is drawn to its own shape. Hover one to give it a different photo."
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Monitors.Count, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- ==================== Placement ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="HOW PHOTOS ARE PLACED" Style="{StaticResource Text.SectionLabel}" />
                    <TextBlock Text="These rules decide how every photo is fitted to your screens."
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,-4,0,12" />

                    <!-- Only meaningful with more than one display -->
                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding HasMultipleMonitors, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ACROSS DISPLAYS" Style="{StaticResource Text.SectionLabel}" />
                        <WrapPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource Chip}" Content="Different photo each"
                                          Margin="0,0,6,6"
                                          IsChecked="{Binding MultiMonitor, Converter={StaticResource EnumMatch}, ConverterParameter=DifferentPerMonitor}" />
                            <ToggleButton Style="{StaticResource Chip}" Content="Same photo everywhere"
                                          Margin="0,0,6,6"
                                          IsChecked="{Binding MultiMonitor, Converter={StaticResource EnumMatch}, ConverterParameter=SameOnAllMonitors}" />
                            <ToggleButton Style="{StaticResource Chip}" Content="Span across displays"
                                          Margin="0,0,6,6"
                                          IsChecked="{Binding MultiMonitor, Converter={StaticResource EnumMatch}, ConverterParameter=SpanAcrossMonitors}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding MultiMonitorDescription}"
                                   Style="{StaticResource Text.Body}" Margin="0,7,0,0" />
                    </StackPanel>

                    <!-- Scaling -->
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="FITTING" Style="{StaticResource Text.SectionLabel}" />
                        <ComboBox ItemsSource="{Binding ScalingModes}"
                                  SelectedItem="{Binding Scaling}"
                                  Width="220" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ScalingDescription}"
                                   Style="{StaticResource Text.Body}" Margin="0,9,0,0" />
                    </StackPanel>

                    <!-- Only Fit and Center leave anything to fill -->
                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding ShowsLetterboxOptions, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="EMPTY AREA" Style="{StaticResource Text.SectionLabel}" />
                        <ComboBox ItemsSource="{Binding LetterboxStyles}"
                                  SelectedItem="{Binding LetterboxStyle}"
                                  Width="220" HorizontalAlignment="Left" />
                        <TextBlock Text="What fills the screen around a photo that does not cover it completely."
                                   Style="{StaticResource Text.Body}" Margin="0,9,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== Per display ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,4"
                    Visibility="{Binding HasMultipleMonitors, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="PER DISPLAY" Style="{StaticResource Text.SectionLabel}" />
                    <TextBlock Text="Overrides for a single screen. Leave the scaling blank and it follows the setting above."
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,-4,0,12" />

                    <Grid Margin="11,18,11,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="168" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DISPLAY"
                                   Style="{StaticResource Text.SectionLabel}" Margin="0" />
                        <TextBlock Grid.Column="1" Text="INCLUDE IN ROTATION"
                                   Style="{StaticResource Text.SectionLabel}" Margin="0" />
                        <TextBlock Grid.Column="2" Text="SCALING"
                                   Style="{StaticResource Text.SectionLabel}" Margin="0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Monitors}"
                                  ItemTemplate="{StaticResource MonitorRowTemplate}" />
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
